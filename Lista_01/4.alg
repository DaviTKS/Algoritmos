algoritmo zero

var 
    N1: inteiro


inicio

    escreva("Digite um número: ")
    leia(N1)


    se N1 < 0 entao
        escreval("O número escolhido é menor que 0")
    senao se N1 = 0 entao 
        escreval("O número escolhido é igual a 0")
    senao 
        escreval("O número escolhido é maior que 0")
    fimse
    fimse

fimalgoritmo