algoritmo idade

var 
    idade: inteiro

inicio

    escreva("Digite a sua idade: ")
    leia(idade)


    se idade < 18 entao
        escreval("Você é menor de idade.")
    senao se idade >= 60 entao
        escreval("Você é idoso.")
    senao se idade >= 18 entao
        escreval("Você é maior de idade.")
    fimse
    fimse
    fimse

fimalgoritmo