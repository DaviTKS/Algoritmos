algoritmo calculo_fatorial

var
    numero: inteiro
    contador: inteiro
    fatorial: inteiro

inicio

    escreva("Digite um numero inteiro: ")
    leia(numero)

    fatorial <- 1

    para contador de 1 ate numero faca
        fatorial <- fatorial * contador
    fimpara

    escreva("O fatorial de ", numero, " é: ", fatorial)

fimalgoritmo
